//STKALLOC JOB (SITEACCT),'STKCP ALLOC',CLASS=A,MSGCLASS=H,
//             NOTIFY=&SYSUID
//* UNVERIFIED TEMPLATE. Replace JOB card and all site placeholders.
//* Do not submit when any target already exists. No data is deleted.
//         SET HLQ=YOURHLQ
//         SET DISK=SITEUNIT
//* Confirm SMS/PDSE availability and the site's allocation defaults.
//ALLOC    EXEC PGM=IEFBR14
//* IEFBR14 performs allocation only; it does not check batch balances.
//JCLLIB   DD DSN=&HLQ..STKCP.JCL,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(2,1)),DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//COBSRC   DD DSN=&HLQ..STKCP.COBOL,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(4,2)),DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=255,BLKSIZE=0)
//REXXSRC  DD DSN=&HLQ..STKCP.REXX,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(2,1)),DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//COPYLIB  DD DSN=&HLQ..STKCP.COPYLIB,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(2,1)),DSNTYPE=LIBRARY,
//            DCB=(RECFM=FB,LRECL=255,BLKSIZE=0)
//LOADLIB  DD DSN=&HLQ..STKCP.LOAD,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(5,2)),DSNTYPE=LIBRARY,
//            DCB=(RECFM=U,LRECL=0,BLKSIZE=32760)
//ORDERS   DD DSN=&HLQ..STKCP.ORDERS,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(2,1)),
//            DCB=(RECFM=FB,LRECL=59,BLKSIZE=0)
//HOLDINGS DD DSN=&HLQ..STKCP.HOLDINGS,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(2,1)),
//            DCB=(RECFM=FB,LRECL=26,BLKSIZE=0)
//PRICES   DD DSN=&HLQ..STKCP.PRICES,DISP=(NEW,CATLG,DELETE),
//            UNIT=&DISK,SPACE=(TRK,(5,2)),
//            DCB=(RECFM=FB,LRECL=32,BLKSIZE=0)
